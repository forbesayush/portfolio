# =============================================================================
# BACKEND SECURITY CONFIGURATION (.env)
# =============================================================================
# IMPORTANT: DO NOT commit your .env file to GitHub.
# Store these in your server environment or hosting provider dashboard.

PORT=5000
NODE_ENV=production

# -----------------------------------------------------------------------------
# 1. Telegram Bot Credentials (Server-to-Server Only)
# -----------------------------------------------------------------------------
# Create a dedicated bot via @BotFather on Telegram (use /newbot or /revoke).
# NEVER expose this token in client-side code, git repos, or browser devtools.
TELEGRAM_BOT_TOKEN=YOUR_REVOKED_AND_ROTATED_BOT_TOKEN

# Your private Telegram Chat ID where alerts are delivered
TELEGRAM_CHAT_ID=6290094136

# -----------------------------------------------------------------------------
# 2. CORS Lockdown
# -----------------------------------------------------------------------------
# Strict origin allowed to call the proxy endpoints in production
ALLOWED_ORIGIN=https://ayushchatterjee.me
FRONTEND_URL=https://ayushchatterjee.me

# -----------------------------------------------------------------------------
# 3. Optional Bot Abuse Protection (Cloudflare Turnstile)
# -----------------------------------------------------------------------------
# Get from Cloudflare Dashboard -> Turnstile
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# 4. Optional IP Intelligence API Key
# -----------------------------------------------------------------------------
# Any private key for IP/VPN intelligence should stay server-side only
GEOIP_API_KEY=
